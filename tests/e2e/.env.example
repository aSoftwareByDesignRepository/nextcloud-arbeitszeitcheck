# Dev/CI E2E only — customers never configure this. Copy to .env and fill in passwords
# for your local Docker Nextcloud instance.
# Users must exist and have ArbeitszeitCheck access (see occ user:list).
# Substitute workflow E2E needs vacation balance for e2e_employee.
# `./scripts/run-e2e-docker.sh` runs `seed-e2e-vacation-docker.sh` (occ ensure-e2e-vacation).
# Or manually: docker compose exec nextcloud php occ arbeitszeitcheck:ensure-e2e-vacation e2e_employee --force

NC_BASE_URL=http://localhost:8081

# Optional: admin-only E2E (Employees table width, profile save)
# NC_ADMIN_USER=admin
# NC_ADMIN_PASS=

NC_EMPLOYEE_USER=e2e_employee
NC_EMPLOYEE_PASS=

NC_MANAGER_USER=e2e_manager
NC_MANAGER_PASS=

NC_SUBSTITUTE_USER=e2e_substitute
NC_SUBSTITUTE_PASS=

# BOLA attacker (tests/e2e/bola-time-entry-ownership.spec.js) — SEC-R4-04:
# Must be a normal employee. Do NOT add this user to the Nextcloud `admin` group
# and do NOT grant ArbeitszeitCheck app-admin. Admin rights collapse ownership
# checks and make the suite a false green.
# NC_BOLA_ATTACKER_USER=azc_bola_b
# NC_BOLA_ATTACKER_PASS=
